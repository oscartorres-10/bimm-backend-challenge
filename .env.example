# -----------------------------------------------------------------------------
# Example configuration. Copy to `.env` (or `.env.<NODE_ENV>.local`) and edit.
# Every variable is optional: the values shown are the defaults.
# Real environment variables always override values from .env files.
# -----------------------------------------------------------------------------

# --- General -----------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- Logging -----------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs (needs the pino-pretty dev dependency).
LOG_PRETTY=false

# --- External vPIC API -------------------------------------------------------
VPIC_ALL_MAKES_URL=https://vpic.nhtsa.dot.gov/api/vehicles/getallmakes?format=XML
# {makeId} is replaced with each make's id
VPIC_VEHICLE_TYPES_URL_TEMPLATE=https://vpic.nhtsa.dot.gov/api/vehicles/GetVehicleTypesForMakeId/{makeId}?format=xml
HTTP_TIMEOUT_MS=15000
HTTP_MAX_RETRIES=3
HTTP_RETRY_BASE_DELAY_MS=500

# --- Ingestion ---------------------------------------------------------------
INGESTION_CONCURRENCY=10
INGESTION_BATCH_SIZE=250
# 0 = all makes (~12,000; a full run takes several minutes)
INGESTION_MAKE_LIMIT=0

# --- Feature flags -----------------------------------------------------------
FEATURE_INGESTION_ON_STARTUP=true
FEATURE_INGESTION_SKIP_IF_POPULATED=true
FEATURE_INGESTION_MUTATION=true

# --- GraphQL -----------------------------------------------------------------
GRAPHQL_INTROSPECTION=true
GRAPHQL_PLAYGROUND=true
GRAPHQL_MAX_PAGE_SIZE=1000

# --- Database ----------------------------------------------------------------
# sqlite | postgres
DB_TYPE=sqlite
# SQLite only (":memory:" = temporary in-RAM database)
DB_SQLITE_PATH=data/vehicles.sqlite
# PostgreSQL only
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=vehicles
DB_SSL=false
# Both
DB_LOGGING=false
DB_MIGRATIONS_RUN=true
